{
  "configVersion": "v3",
  "app": {
    "appId": 1099991,
    "appName": "Pet Universe",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "vender": "zepp",
    "description": "Pet Universe virtual pet companion",
    "icon": "icon.png"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "data:user.hd.step"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
